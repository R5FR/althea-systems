# Tout ignorer sauf le dossier frontend
*
!.gitignore
!frontend/
!frontend/**
!docs/
!docs/**

# Ignorer les artefacts de build dans frontend
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.cache/
frontend/.env
frontend/.env.*
frontend/.env.local

# OS & editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*~
